# HTTPS automático (Let's Encrypt) para o domínio em LEIS_DOMINIO.

{$LEIS_DOMINIO} {
	encode zstd gzip

	request_body {
		max_size 1MB
	}

	reverse_proxy leis-mcp:8000 {
		flush_interval -1
		# Acima do tempo máximo de uma ferramenta (235 s); com menos, o cliente recebe 502.
		transport http {
			read_timeout 245s
		}
	}

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		-Server
	}

	# Esconde o código e o state do OAuth que vêm na URL de /auth/callback.
	log {
		output stdout
		format filter {
			request>uri query {
				replace code REDACTED
				replace state REDACTED
			}
			wrap console
		}
	}
}

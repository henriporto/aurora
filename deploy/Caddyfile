# HTTPS automático (Let's Encrypt) para o domínio em LEIS_DOMINIO.
# O DNS do domínio precisa apontar para o IP da VM antes de subir.

{$LEIS_DOMINIO} {
	encode zstd gzip

	request_body {
		max_size 1MB
	}

	reverse_proxy leis-mcp:8000 {
		# Respostas em streaming (SSE) não podem ficar presas em buffer.
		flush_interval -1
		# Acima dos 235 s que uma ferramenta pode levar (TIMEOUT_FERRAMENTA_SEG):
		# com menos, o cliente recebe 502 em vez do resultado ou do aviso de tempo.
		transport http {
			read_timeout 245s
		}
	}

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		-Server
	}

	log {
		output stdout
		format console
	}
}

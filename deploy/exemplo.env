# Copie para deploy/.env e preencha.

# Domínio público, sem https://
LEIS_DOMINIO=
# Pasta do host que contém leis.db
LEIS_BANCO_DIR=/srv/leis/banco

LEIS_AUTH=google
# URL pública, com https://
LEIS_URL_PUBLICA=
# Cliente OAuth do Google, tipo "Aplicativo da Web"
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Chave aleatória de 32+ caracteres
LEIS_JWT_CHAVE=

# E-mails de administrador, separados por vírgula
LEIS_ADMINS=
# Papel de conta nova: pendente ou usuario
LEIS_PAPEL_PADRAO=usuario
# Chamadas por dia para quem não tem cota própria
LEIS_COTA_PADRAO=100
LEIS_FUSO_COTA=America/Sao_Paulo

LEIS_BUSCAS_SIMULTANEAS=2
LEIS_ESPERA_MAXIMA_SEG=45
LEIS_TOP_K=40
LEIS_MAX_CHARS_PAGINA=100000
LEIS_SQL_TIMEOUT_SEG=230
LEIS_LOG_NIVEL=INFO

# Copie para deploy/.env e preencha. O .env NUNCA vai para o git.
# Referência completa das variáveis: docs/configuracao.md

# ---- Infraestrutura (lidas pelo docker compose) ----------------------------
# Domínio público do servidor, sem https:// (ex.: mcp.seudominio.com.br)
LEIS_DOMINIO=
# Pasta do HOST que contém leis.db (na VM criada pelos scripts: /srv/leis/banco)
LEIS_BANCO_DIR=/srv/leis/banco

# ---- Autenticação Google ---------------------------------------------------
LEIS_AUTH=google
# URL pública completa, com https:// (ex.: https://mcp.seudominio.com.br)
LEIS_URL_PUBLICA=
# Cliente OAuth do tipo "Aplicativo da Web" (docs/autenticacao.md)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Chave aleatória de 32+ caracteres. Gere com:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# Trocar esta chave obriga todos os usuários a fazer login de novo.
LEIS_JWT_CHAVE=

# ---- Usuários e cotas ------------------------------------------------------
# E-mails de administrador, separados por vírgula (sem cota, veem o SQL livre)
LEIS_ADMINS=
# Papel de quem entra pela primeira vez: pendente (aguarda aprovação) ou usuario
LEIS_PAPEL_PADRAO=usuario
# Chamadas de ferramenta por dia para quem não tem cota própria
LEIS_COTA_PADRAO=100
LEIS_FUSO_COTA=America/Sao_Paulo

# ---- Busca e respostas -----------------------------------------------------
# Buscas pesadas simultâneas (2 para e2-standard-2)
LEIS_BUSCAS_SIMULTANEAS=2
# Espera máxima por vaga; depois disso a chamada volta "servidor ocupado"
LEIS_ESPERA_MAXIMA_SEG=45
LEIS_TOP_K=40
LEIS_MAX_CHARS_PAGINA=100000
LEIS_SQL_TIMEOUT_SEG=230
LEIS_LOG_NIVEL=INFO
